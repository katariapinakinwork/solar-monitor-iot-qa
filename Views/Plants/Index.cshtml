@using IoT_Test.Models
@model List<SolarPlant>
@{
    ViewData["Title"] = "Solar Plants";
    var todayGen = ViewBag.TodayGen as Dictionary<int, double> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1 fw-bold"><i class="bi bi-grid-3x3-gap text-primary me-2"></i>Solar Plants</h1>
        <p class="text-muted mb-0 small">Manage and monitor all solar installations in your portfolio</p>
    </div>
    <div class="text-muted small">
        Showing <strong>@Model.Count</strong> plants
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Search</label>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm"
                       placeholder="Name or location..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetNames<PlantStatus>())
                    {
                        if (ViewBag.Status == s) { <option value="@s" selected>@s</option> } else { <option value="@s">@s</option> }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Region</label>
                <select name="region" class="form-select form-select-sm">
                    <option value="">All Regions</option>
                    @foreach (var r in (ViewBag.Regions as List<string> ?? []))
                    {
                        if (ViewBag.Region == r) { <option value="@r" selected>@r</option> } else { <option value="@r">@r</option> }
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-x"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Plants Grid -->
@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-search fs-1 d-block mb-3"></i>
        <h5>No plants found</h5>
        <p>Try adjusting your filters.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var plant in Model)
        {
            var statusColor = plant.Status switch {
                PlantStatus.Online => "success",
                PlantStatus.Offline => "danger",
                PlantStatus.Maintenance => "warning",
                PlantStatus.Degraded => "orange",
                _ => "secondary"
            };
            var statusIcon = plant.Status switch {
                PlantStatus.Online => "bi-check-circle-fill",
                PlantStatus.Offline => "bi-x-circle-fill",
                PlantStatus.Maintenance => "bi-tools",
                PlantStatus.Degraded => "bi-exclamation-triangle-fill",
                _ => "bi-question-circle"
            };
            var genToday = todayGen.TryGetValue(plant.Id, out var g) ? g : 0;
            var genPct = plant.CapacityKw > 0 ? Math.Min(100, genToday / plant.CapacityKw * 100 / 10) : 0; // rough % of daily potential

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 plant-card">
                    <div class="card-body">
                        <!-- Header -->
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h6 class="fw-bold mb-1">@plant.Name</h6>
                                <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@plant.Location</small>
                            </div>
                            <span class="badge bg-@statusColor @(plant.Status == PlantStatus.Maintenance ? "text-dark" : "")">
                                <i class="bi @statusIcon me-1"></i>@plant.Status
                            </span>
                        </div>

                        <!-- Metrics -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="metric-box p-2 rounded-2 bg-light text-center">
                                    <div class="fw-bold">@(plant.CapacityKw.ToString("N0")) kW</div>
                                    <div class="text-muted" style="font-size:0.72rem;">Capacity</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="metric-box p-2 rounded-2 bg-light text-center">
                                    <div class="fw-bold text-success">@(genToday.ToString("N1")) kWh</div>
                                    <div class="text-muted" style="font-size:0.72rem;">Today</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="metric-box p-2 rounded-2 bg-light text-center">
                                    <div class="fw-bold">@plant.PanelCount.ToString("N0")</div>
                                    <div class="text-muted" style="font-size:0.72rem;">Panels</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="metric-box p-2 rounded-2 bg-light text-center">
                                    <div class="fw-bold">@plant.CommissionedDate.ToString("yyyy")</div>
                                    <div class="text-muted" style="font-size:0.72rem;">Commissioned</div>
                                </div>
                            </div>
                        </div>

                        @if (plant.Alerts.Any())
                        {
                            <div class="alert alert-danger alert-sm py-1 px-2 mb-3 d-flex align-items-center gap-2 small">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <span>@plant.Alerts.Count active alert(s)</span>
                            </div>
                        }

                        <!-- Region Badge -->
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-secondary-subtle text-secondary">@plant.Region</span>
                            <a asp-controller="Plants" asp-action="Detail" asp-route-id="@plant.Id"
                               class="btn btn-sm btn-primary">
                                <i class="bi bi-arrow-right me-1"></i>View Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
