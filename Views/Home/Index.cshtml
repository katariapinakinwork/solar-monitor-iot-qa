@using IoT_Test.Models
@using IoT_Test.Models.ViewModels
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1 fw-bold"><i class="bi bi-speedometer2 text-warning me-2"></i>Fleet Dashboard</h1>
        <p class="text-muted mb-0 small">Real-time overview of your solar energy portfolio</p>
    </div>
    <div class="text-end">
        <span class="text-muted small">Last updated: <strong id="lastUpdated">Just now</strong></span>
    </div>
</div>

<!-- KPI Cards Row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card kpi-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1">Total Capacity</p>
                        <h3 class="fw-bold mb-0">@(Model.TotalCapacityKw.ToString("N0")) <small class="text-muted fs-6">kW</small></h3>
                        <small class="text-muted">@Model.TotalPlants plants</small>
                    </div>
                    <div class="kpi-icon bg-primary-subtle rounded-3 p-2">
                        <i class="bi bi-lightning-charge-fill text-primary fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1">Today's Generation</p>
                        <h3 class="fw-bold mb-0 text-success">@(Model.TodayGenerationKwh.ToString("N1")) <small class="text-muted fs-6">kWh</small></h3>
                        <small class="text-muted">Month: @(Model.MonthGenerationKwh.ToString("N0")) kWh</small>
                    </div>
                    <div class="kpi-icon bg-success-subtle rounded-3 p-2">
                        <i class="bi bi-sun-fill text-success fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1">Fleet Performance</p>
                        <h3 class="fw-bold mb-0 @(Model.FleetPerformanceRatio >= 0.8 ? "text-success" : "text-warning")">
                            @((Model.FleetPerformanceRatio * 100).ToString("N1"))<small class="text-muted fs-6">%</small>
                        </h3>
                        <small class="text-muted">PR Ratio: @Model.FleetPerformanceRatio</small>
                    </div>
                    <div class="kpi-icon bg-warning-subtle rounded-3 p-2">
                        <i class="bi bi-graph-up text-warning fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1">CO₂ Avoided</p>
                        <h3 class="fw-bold mb-0 text-info">@(Model.CO2AvoidedTons.ToString("N1")) <small class="text-muted fs-6">t</small></h3>
                        <small class="text-muted">Lifetime total</small>
                    </div>
                    <div class="kpi-icon bg-info-subtle rounded-3 p-2">
                        <i class="bi bi-cloud-check-fill text-info fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Status & Alerts Row -->
<div class="row g-3 mb-4">
    <!-- Plant Status -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pb-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-grid-3x3-gap me-2 text-primary"></i>Plant Status</h6>
            </div>
            <div class="card-body">
                <div class="row g-2 text-center">
                    <div class="col-6">
                        <div class="p-2 rounded-3 bg-success-subtle">
                            <div class="fs-2 fw-bold text-success">@Model.OnlinePlants</div>
                            <small class="text-muted">Online</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded-3 bg-danger-subtle">
                            <div class="fs-2 fw-bold text-danger">@Model.OfflinePlants</div>
                            <small class="text-muted">Offline</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded-3 bg-warning-subtle">
                            <div class="fs-2 fw-bold text-warning">@Model.MaintenancePlants</div>
                            <small class="text-muted">Maint./Degraded</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded-3 bg-danger-subtle">
                            <div class="fs-2 fw-bold text-danger">@Model.CriticalAlerts</div>
                            <small class="text-muted">Critical Alerts</small>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-controller="Plants" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">
                        <i class="bi bi-arrow-right-circle me-1"></i>View All Plants
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Hourly Chart -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pb-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-bar-chart-fill me-2 text-warning"></i>Today's Fleet Production (kWh)</h6>
                <span class="badge bg-success-subtle text-success">Live</span>
            </div>
            <div class="card-body">
                <canvas id="hourlyChart" height="120"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Plants Table + Recent Alerts -->
<div class="row g-3">
    <!-- Plants Quick View -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-list-ul me-2 text-primary"></i>Plants Overview</h6>
                <a asp-controller="Plants" asp-action="Index" class="btn btn-sm btn-link p-0">View all</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Plant Name</th>
                                <th>Capacity</th>
                                <th>Status</th>
                                <th>Alerts</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var plant in Model.Plants)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="fw-semibold">@plant.Name</div>
                                        <small class="text-muted">@plant.Location</small>
                                    </td>
                                    <td>@(plant.CapacityKw.ToString("N0")) kW</td>
                                    <td>
                                        @{
                                            var (badge, icon) = plant.Status switch {
                                                PlantStatus.Online => ("bg-success", "bi-check-circle-fill"),
                                                PlantStatus.Offline => ("bg-danger", "bi-x-circle-fill"),
                                                PlantStatus.Maintenance => ("bg-warning text-dark", "bi-tools"),
                                                PlantStatus.Degraded => ("bg-orange text-white", "bi-exclamation-triangle-fill"),
                                                _ => ("bg-secondary", "bi-question-circle")
                                            };
                                        }
                                        <span class="badge @badge">
                                            <i class="bi @icon me-1"></i>@plant.Status
                                        </span>
                                    </td>
                                    <td>
                                        @if (plant.Alerts.Any())
                                        {
                                            <span class="badge bg-danger">@plant.Alerts.Count</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="Plants" asp-action="Detail" asp-route-id="@plant.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Alerts -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-bell-fill me-2 text-danger"></i>Recent Alerts</h6>
                <a asp-controller="Alerts" asp-action="Index" class="btn btn-sm btn-link p-0">View all</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentAlerts.Any())
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-check-circle-fill text-success fs-3 d-block mb-2"></i>
                        No recent alerts
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var alert in Model.RecentAlerts)
                        {
                            var severityClass = alert.Severity switch {
                                AlertSeverity.Critical => "border-start border-danger border-3",
                                AlertSeverity.Warning => "border-start border-warning border-3",
                                _ => "border-start border-info border-3"
                            };
                            <li class="list-group-item @severityClass py-2 px-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="small">
                                        <div class="fw-semibold">@alert.Title</div>
                                        <div class="text-muted">@alert.SolarPlant?.Name</div>
                                    </div>
                                    <span class="badge @(alert.IsResolved ? "bg-secondary" : alert.Severity == AlertSeverity.Critical ? "bg-danger" : alert.Severity == AlertSeverity.Warning ? "bg-warning" : "bg-info") ms-2">
                                        @alert.Severity
                                    </span>
                                </div>
                                <small class="text-muted">@alert.TriggeredAt.ToString("MMM dd, HH:mm")</small>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HourlyProductionToday.Select(p => p.Label)));
    const values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HourlyProductionToday.Select(p => p.Value)));

    new Chart(document.getElementById('hourlyChart'), {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Energy (kWh)',
                data: values,
                backgroundColor: 'rgba(255, 193, 7, 0.6)',
                borderColor: 'rgba(255, 193, 7, 1)',
                borderWidth: 1,
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, title: { display: true, text: 'kWh' } },
                x: { title: { display: true, text: 'Hour' } }
            }
        }
    });
})();
</script>
}
