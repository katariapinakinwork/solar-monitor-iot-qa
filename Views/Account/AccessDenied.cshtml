@{
    ViewData["Title"] = "Access Denied - 403";
    Layout = "_Layout";
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm text-center p-4 p-md-5">
            <div class="mb-3">
                <span class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle p-4">
                    <i class="bi bi-shield-lock-fill fs-1"></i>
                </span>
            </div>
            <h2 class="fw-bold text-danger mb-2">Access Denied (403)</h2>
            <p class="text-muted mb-4">
                You do not have the required permissions to perform this action or view this resource.
            </p>

            <div class="alert alert-warning py-2 px-3 small text-start mb-4">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                <strong>Role Restriction:</strong> This action requires the <strong>Action Taker</strong> role.
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span>Your current account is signed in as <strong>@User.Identity.Name</strong> with role <strong>@(User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Viewer")</strong>.</span>
                }
            </div>

            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-speedometer2 me-1"></i> Return to Dashboard
                </a>
                <a asp-controller="Alerts" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-bell me-1"></i> Back to Alerts
                </a>
                <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-box-arrow-right me-1"></i> Switch Account
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
